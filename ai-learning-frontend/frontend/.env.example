# ── API base URL ────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5001/api

# Optional CDN config for static chunks/assets.
VITE_CDN_BASE=https://cdn.stellarlearn.com/assets
VITE_CDN_ENABLED=false

# ── Error monitoring (Sentry) ────────────────────────────────────────
# Create project at https://sentry.io → Settings → Projects → DSN
# Leave empty in dev; set in production for automatic error capture
VITE_SENTRY_DSN=
